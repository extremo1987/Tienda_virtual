Options All -Indexes
RewriteEngine on

# Solo HTTPS (se excluye .well-known: la renovación automática del certificado SSL entra por http)
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Métodos HTTP de diagnóstico: bloqueados
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG)$ [NC]
RewriteRule ^ - [F,L]

# Código interno y archivos sensibles: nunca accesibles por URL
RewriteRule ^(Config|Controllers|Models|Helpers|Libraries|Views|database|_server)(/|$) - [F,L]
RewriteRule \.(sql|md|log|bak|example\.php)$ - [F,L]
RewriteRule ^error_log$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
